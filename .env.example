# サイトURL(独自ドメイン取得後に変更)
NEXT_PUBLIC_SITE_URL=https://datsudeji-dojo.com
# AdSenseのパブリッシャーID(例: ca-pub-0000000000000000)
NEXT_PUBLIC_ADSENSE_CLIENT=
# 記事ページの広告ユニットID(任意。未設定なら表示しない)
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
# お問い合わせ(Formspreeのフォームid。未設定ならメール案内のみ)
NEXT_PUBLIC_FORMSPREE_ID=
NEXT_PUBLIC_CONTACT_EMAIL=
# Search Consoleの所有権確認トークン(このサイト専用のもの)
NEXT_PUBLIC_GSC_VERIFICATION=
